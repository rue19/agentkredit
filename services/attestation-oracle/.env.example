# Attestation Oracle Configuration

# Blockchain RPC endpoint
RPC_URL=https://rpc.botchaintestnet.ai

# Attester private key (the key that signs attestations)
ATTESTER_PRIVATE_KEY=

# Deployed contract addresses (after deployment)
AGENT_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=

# Polling interval in milliseconds (how often to check for new events)
POLL_INTERVAL_MS=5000

# Minimum score delta for positive attestation
MIN_POSITIVE_DELTA=5

# Maximum score delta for positive attestation
MAX_POSITIVE_DELTA=20

# Score delta for negative attestation (violations)
NEGATIVE_DELTA=-10
