# Deployer wallet private key (with 0x prefix)
DEPLOYER_PRIVATE_KEY=

# Block explorer API keys (optional, for contract verification)
BOTCHAIN_EXPLORER_API_KEY=
BOHR_EXPLORER_API_KEY=

# Initial attester address for ReputationRegistry deployment
INITIAL_ATTESTER_ADDRESS=

# Gas reporting (set to "true" to enable)
REPORT_GAS=false
